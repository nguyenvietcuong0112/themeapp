<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/innerDownloadContainer"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_gravity="center"
    android:clickable="false"
    android:focusable="false"
    android:duplicateParentState="true"
    app:cardCornerRadius="27dp"
    app:cardElevation="6dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    app:strokeWidth="1dp"
    app:strokeColor="#33FFFFFF"
    android:outlineSpotShadowColor="#59FF5678"
    android:outlineAmbientShadowColor="#59FF5678">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_btn_apply_gradient"
        android:gravity="center"
        android:orientation="horizontal"
        android:duplicateParentState="true"
        android:paddingHorizontal="24dp">

        <ImageView
            android:id="@+id/ivApplyIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_sparkle_gold"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Apply"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>