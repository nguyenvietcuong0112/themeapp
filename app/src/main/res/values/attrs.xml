<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom Theme Semantic Attributes -->
    <attr name="primaryBackgroundColor" format="reference|color" />
    <attr name="secondaryBackgroundColor" format="reference|color" />
    <attr name="titleTextColor" format="reference|color" />
    <attr name="detailTextColor" format="reference|color" />
    <attr name="lineColor" format="reference|color" />
    <attr name="primaryColor" format="reference|color" />
    <attr name="tabBackgroundColor" format="reference|color" />
    <attr name="popupKeysKeyboardStyle" format="reference" />

    <!-- Color Container State Attributes -->
    <attr name="colorContainerChecked" format="color" />
    <attr name="colorContainerUnchecked" format="color" />
    <attr name="colorOnContainerChecked" format="color" />
    <attr name="colorOnContainerUnchecked" format="color" />

    <!-- Keyboard Layout Attributes -->
    <attr name="keyLabelSize" format="dimension|fraction" />
    <attr name="keyLetterSize" format="dimension|fraction" />
    <attr name="keyWidth" format="fraction">
        <enum name="fillRight" value="-1" />
    </attr>
    <attr name="rowHeight" format="dimension|fraction" />
    <attr name="state_has_popup_keys" format="boolean" />
    <attr name="state_left_edge" format="boolean" />
    <attr name="state_right_edge" format="boolean" />
    <attr name="widthChange" format="dimension|fraction" />

    <!-- Custom View Attributes -->
    <attr name="setting_arrowEnabled" format="boolean" />
    <attr name="setting_title" format="reference|string" />

    <!-- Styleables for Custom Views -->
    <declare-styleable name="SettingItemView">
        <attr name="setting_arrowEnabled" />
        <attr name="setting_title" />
    </declare-styleable>
</resources>
